{
  "name": "portal-shell",
  "version": "1.8.3-snapshot",
  "overrides": {
    "browserslist": "4.28.7",
    "fast-uri": "3.1.5",
    "watchpack": "2.5.2"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "build-dev": "ng build --configuration development",
    "clean-cache": "rimraf .angular/cache && echo Cache cleared - next build will be slower but clean",
    "build-fresh": "npm run clean-cache && npm run build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run --coverage && npm run fix-junit-time",
    "test-local": "vitest",
    "test-local-browser": "vitest --browser.headless=false",
    "fix-junit-time": "node scripts/fix-junit-time.mjs",
    "docker": "docker build -t europe-west3-docker.pkg.dev/gematik-all-infra-prod/demis-dev/portal-shell:latest .",
    "build:single-spa:portal-shell": "ng build portal-shell --configuration development",
    "serve:single-spa:portal-shell": "ng s --project portal-shell --disable-host-check --port 4200 --live-reload false"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.2.19",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.19",
    "@angular/compiler": "21.2.19",
    "@angular/core": "21.2.19",
    "@angular/forms": "21.2.19",
    "@angular/material": "21.2.14",
    "@angular/material-luxon-adapter": "21.2.14",
    "@angular/platform-browser": "21.2.19",
    "@angular/router": "21.2.19",
    "@auth0/angular-jwt": "5.2.0",
    "@gematik/demis-portal-core-library": "4.2.10",
    "@gematik/demis-portal-theme-library": "1.3.1",
    "@ngrx/signals": "21.1.1",
    "angular-auth-oidc-client": "21.0.2",
    "bootstrap": "5.3.8",
    "import-map-overrides": "6.1.0",
    "marked": "17.0.1",
    "material-icons": "1.13.14",
    "ngx-logger": "5.0.12",
    "ngx-toastr": "20.0.5",
    "rxjs": "7.8.2",
    "single-spa": "6.0.3",
    "systemjs": "6.15.1",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.6.4",
    "@analogjs/vitest-angular": "2.6.4",
    "@angular-eslint/builder": "21.4.0",
    "@angular-eslint/eslint-plugin": "21.4.0",
    "@angular-eslint/eslint-plugin-template": "21.4.0",
    "@angular-eslint/schematics": "21.4.0",
    "@angular-eslint/template-parser": "21.4.0",
    "@angular/build": "21.2.19",
    "@angular/cli": "21.2.19",
    "@angular/compiler-cli": "21.2.19",
    "@types/jasmine": "6.0.0",
    "@types/luxon": "3.7.1",
    "@types/node": "25.9.3",
    "@types/systemjs": "6.15.4",
    "@typescript-eslint/eslint-plugin": "8.61.1",
    "@typescript-eslint/parser": "8.61.1",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.2",
    "ng-mocks": "14.15.3",
    "playwright": "1.61.1",
    "rimraf": "6.1.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "webpack": "5.107.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.27.3": true,
    "lmdb@3.5.1": true,
    "msgpackr-extract@3.0.4": true
  }
}
